rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Configuration globale & chaînes (synchronisation temps réel client <-> admin)
    match /systemConfig/{docId} {
      allow read, write: if true;
    }

    // 2. Annonces & notifications (diffusion temps réel)
    match /notifications/{notifId} {
      allow read, write: if true;
    }

    // 3. Boîte à souhaits & Signalements (accessible à tous les utilisateurs en envoi, et lisible/gérable par l'app admin)
    match /feedback/{feedbackId} {
      allow read, write: if true;
    }

    // 4. Profils utilisateurs & sauvegardes Cloud
    match /users/{userId} {
      allow read, write: if true;
    }

    // 5. Journal d'activité (logs d'utilisation & monitoring admin)
    match /userActivities/{activityId} {
      allow read, write: if true;
    }

    // 6. Alertes de sécurité
    match /adminSecurityAlerts/{alertId} {
      allow read, write: if true;
    }

    // Règle générale
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
